{
    "name": "tabby/m2-checkout",
    "description": "Tabby payment gateway",
    "type": "magento2-module",
    "version": "7.2.0",
    "require": {
        "php": ">=7.1",
        "guzzlehttp/guzzle": "^7.0",
        "magento/framework": "^103.0.0"
    },
    "license": "MIT",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Tabby\\Checkout\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
