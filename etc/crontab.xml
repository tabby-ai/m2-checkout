<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job instance="Tabby\Checkout\Cron\Service" method="execute" name="tabby_order_service">
            <schedule>*/5 * * * *</schedule>
        </job>
        <job instance="Tabby\Checkout\Cron\WebhookService" method="execute" name="tabby_webhook_service">
            <schedule>0 */6 * * *</schedule>
        </job>
    </group>
</config>
